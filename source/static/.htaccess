# Configuration Apache, pour un hebergement mutualise OVH.
# Ce fichier est ignore par Cloudflare Pages, qui utilise _headers et
# _redirects a la place. Garder les trois ne pose aucun probleme.

Options -Indexes
DirectoryIndex index.html

# Page d'erreur personnalisee
ErrorDocument 404 /404.html

<IfModule mod_rewrite.c>
  RewriteEngine On

  # Forcer HTTPS. Sur OVH, la variable HTTPS n'est pas toujours renseignee :
  # on teste aussi l'en-tete transmis par le repartiteur de charge.
  RewriteCond %{HTTPS} !=on
  RewriteCond %{HTTP:X-Forwarded-Proto} !https
  RewriteRule ^(.*)$ https://%{HTTP_HOST}/$1 [R=301,L]

  # Une seule adresse canonique : sans www. Deux adresses servant le meme
  # contenu font que Google repartit la valeur entre les deux.
  RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
  RewriteRule ^(.*)$ https://%1/$1 [R=301,L]
</IfModule>

# Les fichiers de configuration des autres hebergeurs n'ont pas a etre servis.
<FilesMatch "^(_headers|_redirects)$">
  Require all denied
</FilesMatch>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/plain text/xml
  AddOutputFilterByType DEFLATE application/javascript application/json
  AddOutputFilterByType DEFLATE image/svg+xml
  # Le woff2 est deja compresse : le recompresser ne ferait que couter du CPU.
</IfModule>

<IfModule mod_expires.c>
  ExpiresActive On
  # Images et feuille de style : un an. La feuille est appelee avec un
  # parametre ?v=empreinte recalcule a chaque modification, donc sans risque.
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 year"
  ExpiresByType text/css "access plus 1 year"
  # Les polices portent leur graisse dans leur nom : elles ne changent jamais.
  ExpiresByType font/woff2 "access plus 1 year"
  # Les pages HTML doivent etre revalidees a chaque visite.
  ExpiresByType text/html "access plus 0 seconds"
</IfModule>

<IfModule mod_headers.c>
  Header set X-Content-Type-Options "nosniff"
  Header set Referrer-Policy "strict-origin-when-cross-origin"
  Header set X-Frame-Options "SAMEORIGIN"
  Header set Permissions-Policy "geolocation=(), microphone=(), camera=()"
</IfModule>

AddDefaultCharset UTF-8
